{
  "id": "sprint-board",
  "name": "Sprint board",
  "version": "0.11.0",
  "minWingsVersion": "0.2.17",
  "description": "Your team's current Azure DevOps sprint in a sidebar: items by state with their tasks, details and comments, and board checks with a proposed fix for each. Read-only.",
  "api": 1,
  "main": "dist/native/main.wasm",
  "permissions": {
    "exec": [
      "git remote get-url []",
      "az boards iteration team list [--team --timeframe --project --organization -o]",
      "az boards area team list [--team --project --organization -o]",
      "az boards query [--wiql --project --organization -o]",
      "az boards work-item show [--id --expand --organization -o]",
      "az devops invoke [--area --resource --route-parameters --query-parameters --api-version --organization -o]",
      "az devops project list [--top --organization -o]",
      "az devops team list [--project --top --organization -o]",
      "az repos pr show [--id --detect --organization -o]",
      "az rest [--resource --url -o]",
      "az account show [--query -o]",
      "az devops team list-member [--team --project --top --organization -o]",
      "az devops user list [--top --organization -o]",
      "az login [--allow-no-subscriptions --output]"
    ],
    "openUrl": [
      "https://dev.azure.com/"
    ]
  },
  "contributes": {
    "sidebars": [
      {
        "id": "board",
        "title": "Sprint board",
        "icon": "kanban",
        "page": "dist/native/sidebar.wasm"
      }
    ],
    "mcpTools": [
      {
        "name": "board_check",
        "description": "Checks the team's current Azure DevOps sprint board read-only and returns the hygiene findings, each with a proposed fix, then who on the team is working on what and who is blocked with only lower-priority work left. Changes nothing.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    ]
  }
}
